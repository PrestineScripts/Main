-- Prestine Loader

local GAMES_URL = "https://raw.githubusercontent.com/PrestineScripts/Main/refs/heads/main/Games"

local HttpService = game:GetService("HttpService")

local function http_get(url)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(body) == "string" and body ~= "" then
        return body
    end
    return nil, tostring(body)
end

local function fetch_games()
    local lastErr = "unknown error"
    for attempt = 1, 3 do
        local body, err = http_get(GAMES_URL)
        if body then
            local ok, data = pcall(function()
                return HttpService:JSONDecode(body)
            end)
            if ok and type(data) == "table" then
                local list = type(data.Games) == "table" and data.Games or data
                if type(list[1]) == "table" then
                    return list
                end
                lastErr = "Games.json has no games in it"
            else
                lastErr = "Games.json is not valid JSON"
            end
        else
            lastErr = err or lastErr
        end
        if attempt < 3 then task.wait(1) end
    end
    return nil, lastErr
end

local function safe_load_from_url(name, url)
    local body, err = http_get(url)
    if not body then
        warn("[Prestine] Failed to download " .. name .. ": " .. tostring(err))
        return false
    end

    local fn, compileErr = loadstring(body)
    if not fn then
        warn("[Prestine] Failed to compile " .. name .. ": " .. tostring(compileErr))
        return false
    end

    local execOk, execErr = pcall(fn)
    if not execOk then
        warn("[Prestine] Error running " .. name .. ": " .. tostring(execErr))
        return false
    end

    return true
end

local games, fetchErr = fetch_games()
if not games then
    warn("[Prestine] Could not load the games list: " .. tostring(fetchErr))
    return
end

local ByPlaceId, ByUniverseId = {}, {}
for _, entry in ipairs(games) do
    if type(entry) == "table" and type(entry.Name) == "string" then
        for _, id in ipairs(entry.PlaceIds or entry.Ids or {}) do
            id = tonumber(id)
            if id then
                if ByPlaceId[id] then
                    warn("[Prestine] Duplicate place ID " .. id .. ": " .. entry.Name .. " conflicts with " .. ByPlaceId[id].Name)
                else
                    ByPlaceId[id] = entry
                end
            end
        end
        for _, id in ipairs(entry.UniverseIds or {}) do
            id = tonumber(id)
            if id and not ByUniverseId[id] then
                ByUniverseId[id] = entry
            end
        end
    end
end

local entry = ByPlaceId[tonumber(game.PlaceId) or 0]
if not entry and (tonumber(game.GameId) or 0) ~= 0 then
    entry = ByUniverseId[tonumber(game.GameId)]
end

if not entry then
    warn("[Prestine] Unsupported game, place ID: " .. tostring(game.PlaceId))
    return
end

if type(entry.Url) ~= "string" or entry.Url == "" then
    warn("[Prestine] " .. entry.Name .. " has no Url in Games.json")
    return
end

safe_load_from_url(entry.Name, entry.Url)
