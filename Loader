local Games = {
    {
        Name = "Anime Dice",
        Ids = { 113290951185459 },
        Url = "https://raw.githubusercontent.com/PrestineScripts/Loader/refs/heads/main/AnimeDice",
    },
}

local queue = 'loadstring(game:HttpGet("https://raw.githubusercontent.com/PrestineScripts/Main/refs/heads/main/Loader"))()'

if typeof(syn) == "table" and type(syn.queue_on_teleport) == "function" then
    syn.queue_on_teleport(queue)
elseif type(queue_on_teleport) == "function" then
    queue_on_teleport(queue)
end

local ByPlaceId = {}
for _, entry in ipairs(Games) do
    for _, id in ipairs(entry.Ids) do
        if ByPlaceId[id] then
            warn("[Prestine] Duplicate place ID " .. id .. ": " .. entry.Name .. " conflicts with " .. ByPlaceId[id].Name)
        else
            ByPlaceId[id] = entry
        end
    end
end

local function safe_load_from_url(name, url)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok or type(body) ~= "string" or body == "" then
        warn("[Prestine] Failed to download " .. name .. ": " .. tostring(body))
        return false
    end

    local fn, compileErr = loadstring(body)
    if not fn then
        warn("[Prestine] Failed to compile " .. name .. ": " .. tostring(compileErr))
        return false
    end

    local execOk, execErr = pcall(fn)
    if not execOk then
        warn("[Prestine] Error running " .. name .. ": " .. tostring(execErr))
        return false
    end

    return true
end

local entry = ByPlaceId[tonumber(game.PlaceId) or 0]
if entry then
    safe_load_from_url(entry.Name, entry.Url)
else
    warn("[Prestine] Unsupported game, place ID: " .. tostring(game.PlaceId))
end
